{
  "providers": {
    "custom-ai": {
      "network_config": {
        "base_url": "http://host.docker.internal:11435"
      },
      "custom_provider_config": {
        "is_key_less": true,
        "base_provider_type": "openai"
      }
    }
  },
  "plugins": [
    {
      "enabled": true,
      "name": "pii-interceptor",
      "path": "/app/plugins/pii-interceptor.so",
      "version": 1,
      "config": {
        "opa_url": "http://opa:8181/v1/data/chat"
      }
    }
  ]
}