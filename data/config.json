  },
  "providers": {
    "kronk": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Kronk (local)",
      "options": {
        "baseURL": "http://127.0.0.1:11435/v1"
      },
      "models": {
        "Qwen3-0.6B-Q8_0/AGENT": {
          "name": "Qwen3-0.6B-Q8_0",
          "limit": {
